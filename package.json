{
  "name": "playwright-ai-agents",
  "version": "1.0.0",
  "description": "Playwright (TypeScript) test automation framework with Jenkins CI",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:master": "playwright test",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test tests/api",
    "test:web": "playwright test tests/web",
    "test:datadriven": "playwright test --grep @datadriven",
    "report": "playwright show-report reports/html",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "typescript",
    "jenkins"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.8"
  }
}
