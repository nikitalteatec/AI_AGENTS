# 🌍 ENVIRONMENT
APP_ENV=qa # qa | prod | dev

### 🌐 WEB APP CONFIGURATION ###
# 🔗 WEB APP URL
#WEB_APP_URL=http://localhost/opencart/upload/
#WEB_APP_URL=https://tutorialsninja.com/demo/
WEB_APP_URL=https://awesomeqa.com/ui/

# 🔐 WEB APP LOGIN CREDENTIALS (CREATE YOUR OWN CREDENTIALS)
APP_EMAIL=YOUR_APP_EMAIL
APP_PASSWORD=your_value_here

# 🛒 PRODUCT DETAILS
PRODUCT_NAME=MacBook
PRODUCT_QUANTITY=1
TOTAL_PRICE=$602.00

### 🔌 API CONFIGURATION ###
# 🔗 API BASE URL
API_BASE_URL=https://fakestoreapi.com
# 👤 API USER DETAILS
USERNAME=your_api_username
PASSWORD=your_value_here
USER_ID=1
# 🛍 API PRODUCT DETAILS
PRODUCT_ID=1
CART_ID=1
LIMIT=3

# 📅 DATE RANGE
START_DATE=2019-12-10
END_DATE=2020-10-10

# 🔑 BASIC AUTHENTICATION CREDENTIALS (IF REQUIRED)
#BASIC_AUTH_USERNAME=YOUR_USERNAME
#BASIC_AUTH_PASSWORD=your_value_here
# 🔐 API KEY (IF REQUIRED)
#API_KEY=your_value_here
# 🎟 ACCESS TOKEN (IF REQUIRED)
#ACCESS_TOKEN=your_value_here
# 🔄 OAUTH2 CONFIGURATION (IF REQUIRED)
#CLIENT_ID=YOUR_CLIENT_ID
#CLIENT_SECRET=your_value_here
#AUTHORIZATION_CODE=your_value_here
#TOKEN_URL=YOUR_TOKEN_URL
### 🗄 DATABASE CONFIGURATION ###
# 🖥 DATABASE CONNECTION
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_value_here
DB_NAME=openshop
DB_PORT=3306

# 👨‍💼 ADMIN APP LOGIN CREDENTIALS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_value_here
